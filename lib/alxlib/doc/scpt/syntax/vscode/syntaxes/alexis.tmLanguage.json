{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Alexis Script (Core)",
  "scopeName": "source.axc",
  "patterns": [
    { "include": "#strings" },
    { "include": "#char-literals" },
    { "include": "#backtick-strings" },
    { "include": "#comments" },
    { "include": "#numbers" },
    { "include": "#builtin-functions" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#builtin-types" },
    { "include": "#operators" },
    { "include": "#delimiters" }
  ],
  "repository": {
    "strings": {
      "name": "string.quoted.double.axc",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.axc",
          "match": "\\\\[ntr\\\\\"'0]|\\\\x[0-9a-fA-F]{2}"
        }
      ]
    },

    "char-literals": {
      "name": "string.quoted.single.axc",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.axc",
          "match": "\\\\[ntr\\\\\"'0]|\\\\x[0-9a-fA-F]{2}"
        }
      ]
    },

    "backtick-strings": {
      "name": "string.quoted.backtick.axc",
      "begin": "`",
      "end": "`"
    },

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.axc",
          "match": "//.*$"
        },
        {
          "name": "comment.block.axc",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.axc",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?[fF]?\\b|\\b\\d[\\d_]*[eE][+-]?\\d[\\d_]*[fF]?\\b|\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?[fF]?\\b)"
        },
        {
          "name": "constant.numeric.integer.axc",
          "match": "(?<![\\w.])(?:0[xX][0-9a-fA-F](?:[0-9a-fA-F_]*[0-9a-fA-F])?|0[oO][0-7](?:[0-7_]*[0-7])?|0[bB][01](?:[01_]*[01])?|\\d[\\d_]*)(?![\\d_])"
        }
      ]
    },

    "builtin-functions": {
      "match": "\\b(env|type|int|float|string|bool|bytes|vec|map|lst|here|eval|trap)\\b(?=\\s*\\()",
      "name": "support.function.builtin.axc"
    },

    "keywords": {
      "patterns": [
        { "match": "\\b(var|def)\\b", "name": "keyword.declaration.axc" },
        { "match": "\\b(if|else|while|for|switch|case|default)\\b", "name": "keyword.control.axc" },
        { "match": "\\b(break|continue|return)\\b", "name": "keyword.control.axc" },
        { "match": "\\b(import|link|as)\\b", "name": "keyword.control.import.axc" },
        { "match": "\\b(try|catch|throw)\\b", "name": "keyword.control.exception.axc" },
        { "match": "\\bdelete\\b", "name": "keyword.control.delete.axc" }
      ]
    },

    "constants": {
      "match": "\\b(true|false|null|nan|inf)\\b",
      "name": "constant.language.axc"
    },

    "builtin-types": {
      "match": "\\b(int|float|bool|string|bytes|vec|map|lst)\\b",
      "name": "storage.type.axc"
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.axc",
          "match": "<<=|>>=|<<|>>|::|\\.\\.|\\+\\+|--|&&|\\|\\||!=|==|<=|>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^="
        },
        {
          "name": "keyword.operator.axc",
          "match": "[+\\-*/%&|^~<>=!?:@]"
        },
        {
          "name": "keyword.operator.access.axc",
          "match": "\\."
        }
      ]
    },

    "delimiters": {
      "match": "[{}()\\[\\];,]",
      "name": "punctuation.delimiter.axc"
    }
  }
}
