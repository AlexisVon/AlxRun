# Encoding names -- the engine folds case and separators, and an unknown one answers with
# suggestions (measured 2026-09-20: `utf-9` -> "did you mean: utf8, utf16, utf8bom"). The quoted
# forms are what a program actually carries; the near misses put the suggestion path in reach.
"\"utf-8\""
"\"UTF-8\""
"\"utf8\""
"\"utf_8\""
"\"utf8bom\""
"\"utf-16le\""
"\"gbk\""
"\"GBK\""
"\"base64\""
"\"hex\""
"\"HEX\""
"\"utf-9\""
"\"base65\""
"\"hexx\""
